      "html": "<nav class=\"ds-toc\" aria-label=\"В этой главе\"><p>В ЭТОЙ ГЛАВЕ</p><a href=\"#damage\">Учёт повреждений</a><a class=\"ds-toc-sub\" href=\"#d12\" aria-current=\"location\">Тест брони Д12</a><a class=\"ds-toc-sub\" href=\"#d6\">Тест выживания Д6</a></nav>",
      "css": ".ds-toc{padding-left:16px;border-left:1px solid var(--line,#b8bca9);font-family:'PT Sans',sans-serif;font-size:15px;line-height:1.35}.ds-toc p{font-size:13px;color:var(--muted,#596052);margin:0 0 12px}.ds-toc a{display:block;padding:10px 9px;color:var(--ink,#252c27);text-decoration:none;border-radius:3px;margin:2px 0;border-left:3px solid transparent}.ds-toc a.ds-toc-sub{padding-left:18px;font-size:14px}.ds-toc a:hover{background:var(--sidebar,#e9ebdd)}.ds-toc a[aria-current=location]{background:var(--table,#d9ddc9);border-left-color:var(--forest,#30483b);font-weight:700}.ds-toc a:focus-visible{outline:3px solid var(--focus,#925c0a);outline-offset:4px}"
